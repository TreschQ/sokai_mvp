# Environment variables for SOKAI Mobile App
# Copy this file to .env and fill in your values

# Thirdweb Client ID
EXPO_PUBLIC_THIRDWEB_CLIENT_ID=your-thirdweb-client-id

# Smart Contract Configuration
EXPO_PUBLIC_CONTRACT_ADDRESS=0xd7ece5177d3b3ad4e26cd9f65facb525eae0afe6
EXPO_PUBLIC_CHILIZ_RPC=https://spicy-rpc.chiliz.com/
EXPO_PUBLIC_CHAIN_ID=88882

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Admin Configuration (if needed)
ADMIN_PRIVATE_KEY=your-admin-private-key